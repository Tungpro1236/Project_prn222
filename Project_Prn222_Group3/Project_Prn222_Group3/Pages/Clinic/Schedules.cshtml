@page
@model Project_Prn222_Group3.Pages.Clinic.SchedulesModel
@{
    ViewData["Title"] = "Lịch làm việc";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Lịch làm việc và thời gian nghỉ</h1>
    <p class="text-muted mb-0">Chỉ khung giờ nằm trong ca làm và không bị chặn mới được đặt lịch.</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h2 class="h6 mb-3">Ca làm theo ngày</h2>
                <form method="post" asp-page-handler="Schedule">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Schedule.UserID" class="form-label">Nhân viên</label>
                            <select asp-for="Schedule.UserID" asp-items="Model.ProviderOptions" class="form-select">
                                <option value="">-- Chọn --</option>
                            </select>
                            <span asp-validation-for="Schedule.UserID" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Schedule.DayOfWeek" class="form-label">Ngày</label>
                            <select asp-for="Schedule.DayOfWeek" asp-items="Model.DayOptions" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Schedule.StartTime" class="form-label">Bắt đầu</label>
                            <input asp-for="Schedule.StartTime" type="time" class="form-control" />
                            <span asp-validation-for="Schedule.StartTime" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Schedule.EndTime" class="form-label">Kết thúc</label>
                            <input asp-for="Schedule.EndTime" type="time" class="form-control" />
                            <span asp-validation-for="Schedule.EndTime" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="Schedule.IsWorking" class="form-check-input" />
                                <label asp-for="Schedule.IsWorking" class="form-check-label">Có làm việc ngày này</label>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-vcms mt-3">Lưu ca làm</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h2 class="h6 mb-3">Chặn một khoảng thời gian</h2>
                <form method="post" asp-page-handler="Block">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Block.UserID" class="form-label">Nhân viên</label>
                            <select asp-for="Block.UserID" asp-items="Model.ProviderOptions" class="form-select">
                                <option value="">-- Chọn --</option>
                            </select>
                            <span asp-validation-for="Block.UserID" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Block.StartAt" class="form-label">Từ</label>
                            <input asp-for="Block.StartAt" type="datetime-local" class="form-control" />
                            <span asp-validation-for="Block.StartAt" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Block.EndAt" class="form-label">Đến</label>
                            <input asp-for="Block.EndAt" type="datetime-local" class="form-control" />
                            <span asp-validation-for="Block.EndAt" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Block.Reason" class="form-label">Lý do</label>
                            <input asp-for="Block.Reason" class="form-control" />
                            <span asp-validation-for="Block.Reason" class="text-danger small"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-vcms mt-3">Chặn khung giờ</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3"><h2 class="h6 mb-0">Ca làm đã lưu</h2></div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>Nhân viên</th><th>Ngày</th><th>Giờ</th><th>Trạng thái</th></tr>
            </thead>
            <tbody>
            @if (Model.Schedules.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted py-4">Chưa có ca làm.</td></tr>
            }
            else
            {
                @foreach (var item in Model.Schedules)
                {
                    <tr>
                        <td class="fw-semibold">@item.User.FullName</td>
                        <td>@SchedulesModel.DayName(item.DayOfWeek)</td>
                        <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                        <td>@(item.IsWorking ? "Làm việc" : "Nghỉ")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3"><h2 class="h6 mb-0">Khung giờ bị chặn</h2></div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>Nhân viên</th><th>Từ</th><th>Đến</th><th>Lý do</th><th></th></tr>
            </thead>
            <tbody>
            @if (Model.Blocks.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">Không có khung giờ bị chặn.</td></tr>
            }
            else
            {
                @foreach (var item in Model.Blocks)
                {
                    <tr>
                        <td class="fw-semibold">@item.User.FullName</td>
                        <td>@ClinicTime.Format(item.StartAt)</td>
                        <td>@ClinicTime.Format(item.EndAt)</td>
                        <td>@(item.Reason ?? "—")</td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="DeleteBlock" asp-route-id="@item.BlockedTimeID">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
