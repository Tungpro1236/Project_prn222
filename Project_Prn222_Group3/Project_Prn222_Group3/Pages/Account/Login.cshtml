@page
@model Project_Prn222_Group3.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="brand-mark mx-auto mb-3">VCMS</div>
                    <h1 class="h4 mb-1">Đăng nhập hệ thống</h1>
                    <p class="text-muted mb-0">Phòng khám thú y VCMS</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Tên đăng nhập</label>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Mật khẩu</label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                    </div>
                    <button type="submit" class="btn btn-vcms w-100">Đăng nhập</button>
                </form>

                <div class="text-center mt-4">
                    <a asp-page="/QueueDisplay" target="_blank" class="small text-decoration-none">
                        Xem màn hình hàng đợi công khai
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
