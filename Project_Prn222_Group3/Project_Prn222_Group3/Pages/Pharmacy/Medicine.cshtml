@page "{id:int?}"
@model Project_Prn222_Group3.Pages.Pharmacy.MedicineModel
@{ ViewData["Title"] = "Thông tin thuốc"; }
<a asp-page="Index">← Nhà thuốc</a>
<h1 class="h3 mt-3 mb-4">Thông tin thuốc</h1>
<form method="post" class="col-lg-7">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="mb-3"><label asp-for="Input.MedicineName" class="form-label">Tên thuốc</label><input asp-for="Input.MedicineName" class="form-control" required maxlength="150" /></div>
    <div class="mb-3"><label asp-for="Input.Unit" class="form-label">Đơn vị</label><input asp-for="Input.Unit" class="form-control" required maxlength="30" /></div>
    <div class="mb-3"><label asp-for="Input.CurrentPrice" class="form-label">Giá hiện tại (VND)</label><input asp-for="Input.CurrentPrice" class="form-control" type="number" min="0" max="1000000000" step="0.01" required /></div>
    <div class="form-check mb-4"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label">Đang sử dụng</label></div>
    <button class="btn btn-vcms">Lưu thuốc</button> <a asp-page="Index" class="btn btn-outline-secondary">Hủy</a>
</form>
