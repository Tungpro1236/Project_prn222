@page
@model Project_Prn222_Group3.Pages.Reception.QueueModel
@{
    ViewData["Title"] = "Hàng đợi hôm nay";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Hàng đợi hôm nay</h1>
        <p class="text-muted mb-0">@Model.Today.ToString("dd/MM/yyyy") · Cập nhật trạng thái lượt khám</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-page="CheckIn" class="btn btn-vcms">Check-in bệnh nhân</a>
        <a asp-page="/QueueDisplay" target="_blank" class="btn btn-outline-secondary">Màn hình hàng đợi</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card"><span>Đang chờ</span><strong>@Model.WaitingCount</strong></div>
    </div>
    <div class="col-md-4">
        <div class="stat-card"><span>Lượt kế tiếp</span><strong>@(Model.NextWaiting?.QueueNumber.ToString("00") ?? "—")</strong></div>
    </div>
    <div class="col-md-4">
        <div class="stat-card"><span>Đã hoàn tất</span><strong>@Model.DoneCount</strong></div>
    </div>
</div>

@if (Model.NowServing is not null)
{
    <div class="now-serving mb-4">
        <div>
            <div class="text-uppercase small opacity-75">
                @(Model.NowServing.Status == QueueStatuses.Serving ? "Đang phục vụ" : "Đã gọi")
            </div>
            <div class="d-flex align-items-baseline gap-3">
                <span class="now-serving-number">@Model.NowServing.QueueNumber.ToString("00")</span>
                <span class="fs-5">@Model.NowServing.Visit.Appointment.Animal.Name</span>
            </div>
            <div class="opacity-75">
                Chủ nuôi: @Model.NowServing.Visit.Appointment.Animal.Client.FullName ·
                Bác sĩ: @Model.NowServing.Visit.Appointment.Veterinarian.FullName
            </div>
        </div>
        <div class="text-end small opacity-75">
            Check-in lúc @ClinicTime.FormatTime(Model.NowServing.Visit.CheckInAt)
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Số</th>
                    <th>Giờ hẹn</th>
                    <th>Thú cưng / chủ nuôi</th>
                    <th>Bác sĩ</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Entries.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Chưa có bệnh nhân nào được check-in hôm nay.</td>
                </tr>
            }
            else
            {
                @foreach (var entry in Model.Entries)
                {
                    var minutesWaiting = Math.Max(0, (int)(ClinicTime.UtcNow - entry.Visit.CheckInAt).TotalMinutes);

                    <tr class="@(entry.Status == QueueStatuses.Serving ? "table-info" : "")">
                        <td><span class="queue-number-badge">@entry.QueueNumber.ToString("00")</span></td>
                        <td>
                            <div>@ClinicTime.FormatTime(entry.Visit.Appointment.AppointmentTime)</div>
                            <div class="text-muted small">Chờ @minutesWaiting phút</div>
                        </td>
                        <td>
                            <div class="fw-semibold">@entry.Visit.Appointment.Animal.Name</div>
                            <div class="text-muted small">@entry.Visit.Appointment.Animal.Client.FullName · @entry.Visit.Appointment.Animal.Client.Phone</div>
                        </td>
                        <td>@entry.Visit.Appointment.Veterinarian.FullName</td>
                        <td>
                            <span class="badge @DisplayText.QueueBadge(entry.Status)">@DisplayText.QueueStatus(entry.Status)</span>
                        </td>
                        <td class="text-end">
                            @if (entry.Status == QueueStatuses.Waiting)
                            {
                                <form method="post" asp-page-handler="Advance" class="d-inline">
                                    <input type="hidden" name="id" value="@entry.QueueEntryID" />
                                    <button type="submit" name="action" value="Call" class="btn btn-sm btn-primary">Gọi</button>
                                </form>
                                <form method="post" asp-page-handler="Advance" class="d-inline"
                                      onsubmit="return confirm('Bỏ qua lượt này?');">
                                    <input type="hidden" name="id" value="@entry.QueueEntryID" />
                                    <button type="submit" name="action" value="Skip" class="btn btn-sm btn-outline-secondary">Bỏ qua</button>
                                </form>
                            }
                            else if (entry.Status == QueueStatuses.Called)
                            {
                                <form method="post" asp-page-handler="Advance" class="d-inline">
                                    <input type="hidden" name="id" value="@entry.QueueEntryID" />
                                    <button type="submit" name="action" value="Serve" class="btn btn-sm btn-info">Bắt đầu</button>
                                </form>
                                <form method="post" asp-page-handler="Advance" class="d-inline"
                                      onsubmit="return confirm('Bỏ qua lượt này?');">
                                    <input type="hidden" name="id" value="@entry.QueueEntryID" />
                                    <button type="submit" name="action" value="Skip" class="btn btn-sm btn-outline-secondary">Bỏ qua</button>
                                </form>
                            }
                            else if (entry.Status == QueueStatuses.Serving)
                            {
                                <form method="post" asp-page-handler="Advance" class="d-inline">
                                    <input type="hidden" name="id" value="@entry.QueueEntryID" />
                                    <button type="submit" name="action" value="Done" class="btn btn-sm btn-success">Hoàn tất</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
