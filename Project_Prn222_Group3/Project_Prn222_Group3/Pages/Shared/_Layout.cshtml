@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var roleName = User.FindFirst(ClaimTypes.Role)?.Value;
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VCMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Project_Prn222_Group3.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-vcms shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Index">
                    VCMS <span class="brand-sub d-none d-md-inline">Veterinary Clinic</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Index">Trang chủ</a>
                            </li>
                        }
                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.ClinicManager))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Staff/Index">Tài khoản nhân viên</a>
                            </li>
                        }
                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Receptionist))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Reception/CheckIn">Check-in</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Reception/Queue">Hàng đợi</a>
                            </li>
                        }
                        @if (User.IsInRole(AppRoles.Client))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Client/Index">Hồ sơ của tôi</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/QueueDisplay" target="_blank" rel="noopener">Hàng đợi công khai</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-lg-center">
                        @if (isAuthenticated)
                        {
                            <li class="nav-item me-lg-3">
                                <span class="navbar-text">
                                    <span class="fw-semibold">@fullName</span>
                                    <span class="d-block small opacity-75">@AppRoles.DisplayName(roleName)</span>
                                </span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Logout">
                                    <button type="submit" class="btn btn-sm btn-light">Đăng xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-light" asp-page="/Account/Login">Đăng nhập</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-3">
        <main role="main" class="pb-3">
            @if (TempData["Flash"] is string flash)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @flash
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["FlashError"] is string flashError)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @flashError
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
