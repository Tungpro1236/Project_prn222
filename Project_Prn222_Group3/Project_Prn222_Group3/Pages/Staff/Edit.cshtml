@page "{id:int}"
@model Project_Prn222_Group3.Pages.Staff.EditModel
@{
    ViewData["Title"] = "Cập nhật tài khoản";
}

<div class="mb-4">
    <a asp-page="Index" class="small text-decoration-none">&larr; Danh sách tài khoản</a>
    <h1 class="h3 mt-2 mb-1">Cập nhật tài khoản</h1>
    <p class="text-muted mb-0">
        Tên đăng nhập: <code>@Model.TargetUsername</code>
        @if (Model.IsSelf)
        {
            <span class="badge bg-light text-dark border ms-2">Tài khoản của bạn</span>
        }
    </p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.FullName" class="form-label">Họ tên</label>
                    <input asp-for="Input.FullName" class="form-control" />
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Phone" class="form-label">Số điện thoại</label>
                    <input asp-for="Input.Phone" class="form-control" />
                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.RoleID" class="form-label">Vai trò</label>
                    @if (Model.IsSelf)
                    {
                        <select class="form-select" disabled>
                            @foreach (var role in Model.RoleOptions)
                            {
                                <option value="@role.Value" selected="@(role.Value == Model.Input.RoleID.ToString())">@role.Text</option>
                            }
                        </select>
                        <input type="hidden" asp-for="Input.RoleID" />
                        <div class="form-text">Không thể tự thay đổi vai trò của mình.</div>
                    }
                    else
                    {
                        <select asp-for="Input.RoleID" asp-items="Model.RoleOptions" class="form-select"></select>
                    }
                    <span asp-validation-for="Input.RoleID" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    @if (Model.IsSelf)
                    {
                        <input type="hidden" asp-for="Input.IsActive" />
                        <span class="badge bg-success">Đang hoạt động</span>
                        <div class="form-text">Không thể tự khóa tài khoản đang đăng nhập.</div>
                    }
                    else
                    {
                        <div class="form-check form-switch">
                            <input asp-for="Input.IsActive" class="form-check-input" />
                            <label asp-for="Input.IsActive" class="form-check-label">Tài khoản đang hoạt động</label>
                        </div>
                    }
                    <span asp-validation-for="Input.IsActive" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />
            <h2 class="h6">Đặt lại mật khẩu</h2>
            <p class="text-muted small">Bỏ trống nếu không muốn thay đổi mật khẩu hiện tại.</p>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.NewPassword" class="form-label">Mật khẩu mới</label>
                    <input asp-for="Input.NewPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ConfirmNewPassword" class="form-label">Xác nhận mật khẩu mới</label>
                    <input asp-for="Input.ConfirmNewPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmNewPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-vcms">Lưu thay đổi</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
