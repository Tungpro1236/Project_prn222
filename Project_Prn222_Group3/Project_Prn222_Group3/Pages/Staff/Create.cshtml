@page
@model Project_Prn222_Group3.Pages.Staff.CreateModel
@{
    ViewData["Title"] = "Thêm tài khoản nhân viên";
}

<div class="mb-4">
    <a asp-page="Index" class="small text-decoration-none">&larr; Danh sách tài khoản</a>
    <h1 class="h3 mt-2 mb-1">Thêm tài khoản nhân viên</h1>
    <p class="text-muted mb-0">Tài khoản mới có thể đăng nhập ngay sau khi được tạo.</p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.FullName" class="form-label">Họ tên</label>
                    <input asp-for="Input.FullName" class="form-control" />
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Username" class="form-label">Tên đăng nhập</label>
                    <input asp-for="Input.Username" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.Username" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Phone" class="form-label">Số điện thoại</label>
                    <input asp-for="Input.Phone" class="form-control" />
                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.RoleID" class="form-label">Vai trò</label>
                    <select asp-for="Input.RoleID" asp-items="Model.RoleOptions" class="form-select">
                        <option value="">-- Chọn vai trò --</option>
                    </select>
                    <span asp-validation-for="Input.RoleID" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Password" class="form-label">Mật khẩu</label>
                    <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password" />
                    <div class="form-text">Tối thiểu 8 ký tự.</div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-vcms">Tạo tài khoản</button>
                <a asp-page="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
